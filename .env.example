# Revenue Recovery OS — Environment Variable Configuration Guide

# ====================================================================
# ENVIRONMENT & APP CONFIGURATION
# ====================================================================
# NODE_ENV: Operating environment ('development' or 'production')
NODE_ENV="production"

# APP_URL: Base URL where this application is hosted (e.g., https://your-domain.com or Cloud Run URL)
# Required in production mode for payment links, webhooks, and checkout redirects.
APP_URL="https://app.revenuerecoveryos.com"

# PROVIDER_SECRET_ENCRYPTION_KEY: 32-character or base64 secret used for AES-256-GCM encryption
# Required in production to securely encrypt stored payment provider credentials in the database.
PROVIDER_SECRET_ENCRYPTION_KEY="replace_with_a_secure_32_byte_random_encryption_key"

# ====================================================================
# SUPABASE CONFIGURATION (Authoritative Database & Authentication)
# ====================================================================
# Required when NODE_ENV=production or STORAGE_MODE=supabase_production
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your_supabase_anon_jwt_key"
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_jwt_key"

# Storage Mode override ('supabase_production' or 'local_development')
STORAGE_MODE="supabase_production"

# ====================================================================
# STRIPE INTEGRATION (Server-Side Secret Key & Webhook Signing Secret)
# ====================================================================
# Obtain from Stripe Dashboard -> Developers -> API keys & Webhooks
STRIPE_SECRET_KEY="sk_live_your_stripe_secret_key"
STRIPE_WEBHOOK_SECRET="whsec_your_stripe_webhook_signing_secret"

# ====================================================================
# RAZORPAY INTEGRATION (Key ID, Secret & Webhook Signing Secret)
# ====================================================================
# Obtain from Razorpay Dashboard -> Settings -> API Keys & Webhooks
RAZORPAY_KEY_ID="rzp_live_your_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"
RAZORPAY_WEBHOOK_SECRET="whsec_your_razorpay_webhook_secret"

# Razorpay Partner OAuth Configuration (1-Click Merchant Authorization)
# Obtain from Razorpay Partner Dashboard -> App Store / Partner Applications
RAZORPAY_CLIENT_ID="rzp_partner_your_client_id"
RAZORPAY_CLIENT_SECRET="your_razorpay_partner_client_secret"
RAZORPAY_REDIRECT_URI="https://app.revenuerecoveryos.com/api/auth/razorpay/callback"

# ====================================================================
# PAYPAL INTEGRATION (REST API Client Credentials & Webhook ID)
# ====================================================================
# Obtain from PayPal Developer Portal -> My Apps & Credentials -> Webhooks
PAYPAL_CLIENT_ID="your_paypal_client_id"
PAYPAL_CLIENT_SECRET="your_paypal_client_secret"
PAYPAL_WEBHOOK_ID="your_paypal_webhook_id"
PAYPAL_ENVIRONMENT="live" # 'live' or 'sandbox'

# ====================================================================
# EMAIL PROVIDER CONFIGURATION (Resend, SendGrid, Postmark, SES)
# ====================================================================
# In production, EMAIL_PROVIDER must be a real provider (e.g. 'resend') and NOT 'mock'.
EMAIL_PROVIDER="resend"
EMAIL_API_KEY="re_123456789_your_resend_api_key"
EMAIL_FROM_ADDRESS="billing@yourdomain.com"

# ====================================================================
# GEMINI AI API (Server-Side Generative AI Analysis)
# ====================================================================
GEMINI_API_KEY="your_gemini_api_key"
